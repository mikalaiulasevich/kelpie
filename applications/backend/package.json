{
  "name": "@kelpie/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node ../../scripts/clean-build.mjs && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "start": "node distribution/source/main.js",
    "development": "npm run build && concurrently --kill-others-on-fail \"tsc --project tsconfig.build.json --watch --preserveWatchOutput\" \"node --watch distribution/source/main.js\"",
    "database:generate": "prisma generate",
    "database:migrate": "tsx source/database/prepare-database-directory.ts && prisma migrate deploy",
    "database:validate": "prisma validate",
    "test": "vitest run",
    "configurations:import": "tsx source/configurations/import-configuration.ts",
    "administration:provision": "tsx source/administration/provision-administrator.ts",
    "start:bun": "bun distribution/source/main.js",
    "development:bun": "npm run build && concurrently --kill-others-on-fail \"tsc --project tsconfig.build.json --watch --preserveWatchOutput\" \"bun --watch distribution/source/main.js\"",
    "test:bun": "bun --bun ../../node_modules/vitest/vitest.mjs run"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.2",
    "@fastify/helmet": "13.1.1",
    "@fastify/rate-limit": "11.2.0",
    "@kelpie/contracts": "0.1.0",
    "@kelpie/funnel-runtime": "0.1.0",
    "@nestjs/common": "12.1.2",
    "@nestjs/core": "12.1.2",
    "@nestjs/platform-fastify": "12.1.2",
    "@prisma/adapter-better-sqlite3": "7.10.0",
    "@prisma/adapter-libsql": "7.10.0",
    "@prisma/client": "7.10.0",
    "ajv": "8.20.0",
    "dotenv": "18.0.5",
    "es-toolkit": "1.52.0",
    "fastify": "5.12.5",
    "pino": "10.4.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "typebox": "1.3.36"
  },
  "devDependencies": {
    "prisma": "7.10.0"
  }
}
