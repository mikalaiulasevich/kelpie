{
  "name": "@kelpie/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "start": "node distribution/source/main.js",
    "development": "npm run build && concurrently --kill-others-on-fail \"tsc --project tsconfig.json --watch --preserveWatchOutput\" \"node --watch distribution/source/main.js\"",
    "database:generate": "prisma generate",
    "database:migrate": "tsx source/database/prepare_database_directory.ts && prisma migrate deploy",
    "database:validate": "prisma validate",
    "test": "vitest run"
  },
  "dependencies": {
    "@nestjs/common": "12.1.2",
    "@nestjs/core": "12.1.2",
    "@nestjs/platform-express": "12.1.2",
    "@prisma/client": "7.10.0",
    "@prisma/adapter-better-sqlite3": "7.10.0",
    "dotenv": "18.0.5",
    "helmet": "8.3.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/testing": "12.1.2",
    "@types/express": "5.0.6",
    "prisma": "7.10.0"
  }
}
