generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource database {
  provider = "sqlite"
}

model Funnel {
  identifier              String          @id
  activeVersionIdentifier String?         @unique
  revision                Int             @default(0)
  createdAt               DateTime        @default(now())
  activeVersion           FunnelVersion?  @relation("ActiveVersion", fields: [identifier, activeVersionIdentifier], references: [funnelIdentifier, identifier], onDelete: Restrict, onUpdate: Restrict)
  versions                FunnelVersion[] @relation("FunnelVersions")
  publications            Publication[]

  @@unique([identifier, activeVersionIdentifier])
}

model FunnelVersion {
  identifier           String        @id @default(uuid())
  funnelIdentifier     String
  version              Int
  schemaVersion        String
  document             Json
  checksum             String
  createdAt            DateTime      @default(now())
  funnel               Funnel        @relation("FunnelVersions", fields: [funnelIdentifier], references: [identifier], onDelete: Restrict, onUpdate: Restrict)
  activeFor            Funnel?       @relation("ActiveVersion")
  sessions             Session[]
  targetPublications   Publication[] @relation("TargetVersion")
  previousPublications Publication[] @relation("PreviousVersion")

  @@unique([funnelIdentifier, version])
  @@unique([funnelIdentifier, identifier])
}

model Publication {
  identifier                String         @id @default(uuid())
  operationIdentifier       String         @unique
  requestFingerprint        String
  revision                  Int
  action                    String
  funnelIdentifier          String
  targetVersionIdentifier   String
  previousVersionIdentifier String?
  administratorIdentifier   String
  createdAt                 DateTime       @default(now())
  funnel                    Funnel         @relation(fields: [funnelIdentifier], references: [identifier], onDelete: Restrict, onUpdate: Restrict)
  targetVersion             FunnelVersion  @relation("TargetVersion", fields: [funnelIdentifier, targetVersionIdentifier], references: [funnelIdentifier, identifier], onDelete: Restrict, onUpdate: Restrict)
  previousVersion           FunnelVersion? @relation("PreviousVersion", fields: [funnelIdentifier, previousVersionIdentifier], references: [funnelIdentifier, identifier], onDelete: Restrict, onUpdate: Restrict)
  administrator             Administrator  @relation(fields: [administratorIdentifier], references: [identifier], onDelete: Restrict, onUpdate: Restrict)

  @@index([funnelIdentifier, createdAt])
  @@unique([funnelIdentifier, revision])
}

model Session {
  identifier            String             @id @default(uuid())
  accessTokenHash       String?            @unique
  versionIdentifier     String
  experimentIdentifier  String
  variant               String
  assignmentSource      String
  trafficOrigin         String
  acquisitionParameters Json
  campaign              String?
  currentStepIdentifier String
  revision              Int                @default(0)
  initialState          Json?
  createdAt             DateTime           @default(now())
  expiresAt             DateTime
  version               FunnelVersion      @relation(fields: [versionIdentifier], references: [identifier], onDelete: Restrict, onUpdate: Restrict)
  answers               SessionAnswer[]
  operations            SessionOperation[]
  transitions           SessionTransition[]
  events                Event[]

  @@index([versionIdentifier, variant, createdAt])
  @@index([campaign, createdAt])
  @@index([trafficOrigin, assignmentSource, createdAt])
  @@index([expiresAt])
}

model SessionAnswer {
  sessionIdentifier String
  stepIdentifier    String
  value             Json
  confirmationRevision Int?
  updatedAt         DateTime @updatedAt
  session           Session  @relation(fields: [sessionIdentifier], references: [identifier], onDelete: Restrict, onUpdate: Restrict)

  @@id([sessionIdentifier, stepIdentifier])
}

model SessionOperation {
  operationIdentifier String
  sessionIdentifier   String
  requestFingerprint  String
  response            Json
  transitions         SessionTransition[]
  createdAt           DateTime @default(now())
  session             Session  @relation(fields: [sessionIdentifier], references: [identifier], onDelete: Restrict, onUpdate: Restrict)

  @@id([sessionIdentifier, operationIdentifier])
  @@index([sessionIdentifier, createdAt])
}

model Event {
  identifier         String   @id
  contentFingerprint String
  sessionIdentifier  String
  name               String
  source             String
  clientTimestamp    DateTime
  serverTimestamp    DateTime @default(now())
  stepIdentifier     String?
  properties         Json
  session            Session  @relation(fields: [sessionIdentifier], references: [identifier], onDelete: Restrict, onUpdate: Restrict)

  @@index([sessionIdentifier, name, stepIdentifier])
  @@index([name, stepIdentifier, sessionIdentifier])
  @@index([serverTimestamp])
}

model Administrator {
  identifier   String                 @id @default(uuid())
  username     String                 @unique
  passwordHash String
  createdAt    DateTime               @default(now())
  sessions     AdministratorSession[]
  publications Publication[]
}

model AdministratorSession {
  identifier              String        @id @default(uuid())
  accessTokenHash         String        @unique
  administratorIdentifier String
  createdAt               DateTime      @default(now())
  expiresAt               DateTime
  revokedAt               DateTime?
  administrator           Administrator @relation(fields: [administratorIdentifier], references: [identifier], onDelete: Restrict, onUpdate: Restrict)

  @@index([expiresAt])
}

model SessionTransition {
  identifier String @id @default(uuid())
  sessionIdentifier String
  operationIdentifier String
  revision Int
  kind String
  fromStepIdentifier String
  toStepIdentifier String
  createdAt DateTime @default(now())
  session Session @relation(fields: [sessionIdentifier], references: [identifier], onDelete: Restrict, onUpdate: Restrict)
  operation SessionOperation @relation(fields: [sessionIdentifier, operationIdentifier], references: [sessionIdentifier, operationIdentifier], onDelete: Restrict, onUpdate: Restrict)

  @@unique([sessionIdentifier, revision])
  @@index([sessionIdentifier, fromStepIdentifier, kind])
}

model ApplicationSecret {
  identifier String @id
  value String
  createdAt DateTime @default(now())
}
